# GEMINI_API_KEY: Required for Gemini AI API calls (Backend only, never exposed to browser)
# AI Studio automatically injects this at runtime from user secrets or Settings -> Secrets panel in AI Studio UI.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Required for OpenRouter fallback AI models (Backend only, never exposed to browser)
# Users can configure this via the Secrets panel in the Google AI Studio UI or Cloud Run environment.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ElevenLabs Conversational AI Configuration (Client-safe)
VITE_ELEVENLABS_AGENT_ID=""

# ELEVENLABS_API_KEY: Optional backend API key for ElevenLabs private agents via signed URL
ELEVENLABS_API_KEY=""

# Firebase Configuration (Client-safe public credentials)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
