rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // AI Agents collection
    match /agents/{agentId} {
      allow read: if true;
      allow write: if isValidId(agentId);
    }

    // Leads / CRM pipeline collection
    match /leads/{leadId} {
      allow read: if true;
      allow write: if isValidId(leadId);
    }

    // AI Calls & Transcripts collection
    match /calls/{callId} {
      allow read: if true;
      allow write: if isValidId(callId);
    }

    // Workflows / Automations collection
    match /workflows/{workflowId} {
      allow read: if true;
      allow write: if isValidId(workflowId);
    }

    // Knowledge Documents collection
    match /documents/{documentId} {
      allow read: if true;
      allow write: if isValidId(documentId);
    }

    // Calendar Appointments collection
    match /appointments/{appointmentId} {
      allow read: if true;
      allow write: if isValidId(appointmentId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
