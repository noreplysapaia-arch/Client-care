rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default safety catch-all: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // AI Agents collection
    match /agents/{agentId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId && isValidId(agentId);
    }

    // Leads / CRM pipeline collection
    match /leads/{leadId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId && isValidId(leadId);
    }

    // AI Calls & Transcripts collection
    match /calls/{callId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId && isValidId(callId);
    }

    // Workflows / Automations collection
    match /workflows/{workflowId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId && isValidId(workflowId);
    }

    // Knowledge Documents collection
    match /documents/{documentId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId && isValidId(documentId);
    }

    // Calendar Appointments collection
    match /appointments/{appointmentId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId && isValidId(appointmentId);
    }

    // Test connection collection (disabled in production)
    match /test/{docId} {
      allow read, write: if false;
    }
  }
}
